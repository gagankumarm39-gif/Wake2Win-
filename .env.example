NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GEMINI_API_KEY=your-gemini-api-key

# Cloudflare Workers AI (second-priority app provider, after Ollama).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Optional. Text model override (default: @cf/meta/llama-4-scout-17b-16e-instruct).
# CLOUDFLARE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

OPENROUTER_API_KEY=your-openrouter-api-key
# Optional. Comma-separated list of VALID OpenRouter model ids, tried in order.
# Leave unset to use the app's curated default list (src/lib/ai/models.ts).
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free

AI_KEY_ENCRYPTION_SECRET=generate-a-random-secret
